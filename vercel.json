{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/game.html",
      "missing": [
        {
          "type": "query",
          "key": "embedded"
        }
      ],
      "destination": "/game-cloud-shell.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/game-cloud-shell.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
